{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kneekura.local/schemas/v1/prototype-bundle.schema.json",
  "title": "KNEEKURA TECH HUB Curated Prototype Bundle v1",
  "type": "object",
  "required": ["bundle_version", "bundle_id", "title", "records"],
  "properties": {
    "bundle_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "pattern": "^bundle:"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string"},
    "domains": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
