{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kneekura.local/schemas/v1/source-acquisition-authorization.schema.json",
  "title": "KNEEKURA TECH HUB v1 Source Acquisition Authorization",
  "type": "object",
  "required": [
    "record_type",
    "id",
    "source_id",
    "decision",
    "selection_decision_id",
    "acquisition_level",
    "revision",
    "allowed_paths",
    "rationale",
    "created_by",
    "policy_version",
    "decided_at"
  ],
  "properties": {
    "record_type": {"const": "source_acquisition_authorization"},
    "id": {"type": "string", "pattern": "^aa:"},
    "source_id": {"type": "string", "pattern": "^src:"},
    "decision": {"enum": ["AUTHORIZE", "REVOKE"]},
    "selection_decision_id": {"type": "string", "pattern": "^sd:"},
    "acquisition_level": {"const": "selected-files"},
    "revision": {"type": "string", "minLength": 1},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "created_by": {
      "type": "object",
      "required": ["actor_type"],
      "properties": {
        "actor_type": {"const": "human"},
        "actor_id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "policy_version": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "supersedes_authorization_id": {"type": ["string", "null"], "pattern": "^aa:"}
  },
  "additionalProperties": false
}
