{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kneekura.local/schemas/v1/selected-file-extraction-proposal.schema.json",
  "title": "KNEEKURA TECH HUB v1 Selected-File Extraction Proposal",
  "type": "object",
  "required": ["proposal_version", "snapshot_id", "findings"],
  "properties": {
    "proposal_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^ss:"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["summary", "anchors"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "candidate_names": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 240}
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["path", "line_start", "line_end"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
