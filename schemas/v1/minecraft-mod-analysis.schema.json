{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kneekura.local/schemas/v1/minecraft-mod-analysis.schema.json",
  "title": "KNEEKURA Minecraft Mod Analysis Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mod_id",
    "display_name",
    "minecraft_version",
    "loader",
    "source_snapshot",
    "overall_status",
    "facets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "mod_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "minecraft_version": {
      "const": "1.20.1"
    },
    "loader": {
      "const": "Forge"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_PINNED",
            "PINNED"
          ]
        },
        "repository": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "jar_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "overall_status": {
      "enum": [
        "QUEUED",
        "IN_PROGRESS",
        "COMPLETE"
      ]
    },
    "facets": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "NOT_ANALYZED",
          "INVENTORIED",
          "MAPPED",
          "EVIDENCE_BACKED",
          "NOT_APPLICABLE"
        ]
      },
      "propertyNames": {
        "enum": [
          "architecture",
          "ai",
          "worldgen",
          "networking",
          "rendering_assets",
          "data_assets",
          "performance",
          "compatibility",
          "license_provenance"
        ]
      }
    },
    "analysis_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
