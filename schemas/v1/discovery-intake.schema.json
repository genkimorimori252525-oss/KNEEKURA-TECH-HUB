{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kneekura.local/schemas/v1/discovery-intake.schema.json",
  "title": "KNEEKURA TECH HUB v1 Controlled Discovery Intake",
  "type": "object",
  "required": [
    "intake_version",
    "batch_id",
    "discovered_by",
    "discovered_at",
    "scope",
    "records"
  ],
  "properties": {
    "intake_version": {"const": "1.0"},
    "batch_id": {"type": "string", "pattern": "^discovery:"},
    "discovered_by": {
      "type": "object",
      "required": ["actor_type"],
      "properties": {
        "actor_type": {"enum": ["human", "ai", "tool", "system"]},
        "actor_id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "discovered_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"const": "github"},
        "query": {"type": ["string", "null"]},
        "selection_basis": {"type": ["string", "null"]},
        "filters": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["record_type", "id"],
        "properties": {
          "record_type": {
            "enum": ["source", "source_snapshot", "evidence", "staged_observation"]
          },
          "id": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "additionalProperties": false
}
