      "id": "T08",
      "title": "Expose ordered transformer extension points with explicit constraints",
      "profile": "frontier",
      "paths": [
        "transformer/src/main/java/org/sinytra/connector/transformer/plugin/PluginManager.java",
        "transformer/src/main/java/org/sinytra/connector/transformer/api/TransformerPlugin.java",
        "transformer/src/main/java/org/sinytra/connector/transformer/plugin/TransformerRegistrarImpl.java"
      ],
      "condition": "Multiple independent transforms and semantic patches need a predictable relationship.",
      "mechanism": "Service-loaded plugins register per-jar transforms and patches through dedicated registrars; ordering constraints and priorities are explicit rather than inferred from discovery order.",
      "invariant": "A consumer must not run before the producer or semantic precondition it depends on.",
      "failure_pattern": "Equating plugin discovery order with execution order or collapsing transformer ordering and patch priority into one rule.",
      "application": "Separate registration from ordering/evaluation and expose dependency constraints in a plugin pipeline.",
      "limits": "FRONTIER-only API; classloader availability, cycles and exact host integration still matter. This is a redesign candidate, not a direct Forge1.20.1 backport.",
