      "symptom": {
        "basis": "DIRECT_OBSERVATION",
        "text": "Both authorized Hydra startup attempts ended with completed JVM exit code 1 before a client window or world. Effective arguments supplied more than one gameDir value.",
        "evidence_ids": [
          "batch-summary",
          "hydra-1-receipt",
          "hydra-1-log",
          "hydra-2-receipt",
          "hydra-2-log"
        ]
      },
      "trigger_conditions": {
        "basis": "DIRECT_OBSERVATION",
        "text": "The managed doFirst guard ran before ForgeGradle MinecraftRunTask.exec. Actual task inspection showed empty ordinary args and providers, while RunConfig already held the default gameDir argument.",
        "evidence_ids": [
          "forge-task-inspection",
          "forge-task-bytecode",
          "init-before"
        ]
      },
      "root_cause": {
        "basis": "INFERENCE",
        "text": "ForgeGradle appended token-expanded RunConfig arguments during MinecraftRunTask.exec after the managed guard had inserted its own gameDir. Materializing ordinary Gradle argument providers could not consume or validate this later Forge-specific append.",
        "evidence_ids": [
          "forge-task-bytecode",
          "forge-task-inspection",
          "init-before",
          "init-insufficient-repair",
          "hydra-2-log"
        ]
      },
      "repair": {
        "basis": "DIRECT_OBSERVATION",
        "text": "The corrected guard validates at the final Gradle argument-provider boundary after inherited Forge setup. It leaves Forge token expansion and RunConfig arguments intact, evaluates original providers in their stock context once, validates the combined arguments and owned working directory, then caches the provider result or rejection. Missing owned options are added only when absent; explicit escaping or duplicate paths are rejected.",
        "evidence_ids": [
          "forge-task-repair",
          "forge-task-regression"
        ]
      },
      "lesson": {
        "basis": "INFERENCE",
        "text": "Verify the actual plugin task execution path and all post-guard argument sources. Passing a generic Gradle provider fixture is insufficient evidence for ForgeGradle startup.",
        "evidence_ids": [
          "ordinary-provider-green",
          "hydra-2-receipt",
          "forge-task-bytecode"
        ]
      },
      "causal_chain": [
        {
          "basis": "INFERENCE",
          "text": "Initial managed argument insertion preceded Forge RunConfig append.",
          "evidence_ids": [
            "init-before",
            "forge-task-bytecode"
          ]
        },
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "The intermediate provider-only patch recorded passing fixture tests, then a fresh authorized Hydra attempt failed with the same duplicate gameDir error.",
          "evidence_ids": [
            "ordinary-provider-green",
            "init-insufficient-repair",
            "hydra-2-receipt",
            "hydra-2-log"
          ]
        },
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "An intermediate Forge pre-expansion patch passed 23 actual-task cases and 103 adjacent tests. Independent follow-on cases then recorded 4 failures and 23 passes, exposing double evaluation of stateful lazy tokens and providers observing incomplete Forge setup.",
          "evidence_ids": [
            "forge-expansion-intermediate",
            "forge-expansion-intermediate-tests",
            "forge-expansion-intermediate-green",
            "forge-expansion-intermediate-adjacent",
            "forge-token-provider-red"
          ]
        },
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "The corrected final-provider boundary recorded 35 passing actual-task cases and 10 passing corrected plain-provider fixture cases. The inherited MinecraftRunTask action and JavaExec.copyTo execute; only final process creation is captured.",
          "evidence_ids": [
            "forge-task-green",
            "forge-task-adjacent-green",
            "forge-task-regression"
          ]
        },
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "The final adjacent run recorded 70 passes and 10 Groovy fixture compilation failures due to an outer variable shadowing the extracted helper local. Renaming that fixture-only variable was followed by 10 passing rerun cases; production repair bytes stayed unchanged.",
          "evidence_ids": [
            "final-adjacent-harness-failure",
            "final-provider-harness-source",
            "forge-task-adjacent-green"
          ]
        }
      ],
