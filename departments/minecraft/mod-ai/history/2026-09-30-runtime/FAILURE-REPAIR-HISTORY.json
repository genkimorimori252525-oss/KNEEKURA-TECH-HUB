      "symptom": {
        "basis": "DIRECT_OBSERVATION",
        "text": "Both receiving-client roles were rejected in preflight with incomplete target capture. Each had two rejected attempts and zero JVM launches.",
        "evidence_ids": [
          "batch-summary",
          "client-execution",
          "control-execution",
          "client-recovery-execution",
          "control-recovery-execution"
        ]
      },
      "trigger_conditions": {
        "basis": "INFERENCE",
        "text": "After the referenced dedicated-server Gradle launch, a formerly absent optional generated-resource root existed as an empty directory. Read-only revalidation then selected an empty directory inventory that had not been retained in the original profile.",
        "evidence_ids": [
          "batch-summary",
          "client-recovery-profile",
          "dependencies-before"
        ]
      },
      "root_cause": {
        "basis": "INFERENCE",
        "text": "The pre-repair target-root selector treated absent and empty optional resource directories differently. The regenerated profile requested the SHA-256 of an empty inventory, which the read-only retained-byte validator correctly refused as uncaptured. The focused offline test reproduced this exact transition.",
        "evidence_ids": [
          "dependencies-before",
          "client-recovery-profile",
          "empty-root-red"
        ]
      },
      "repair": {
        "basis": "DIRECT_OBSERVATION",
        "text": "Normalize only a directly empty, real optional resource directory to the existing explicit absence representation after lstat and bounded scandir identity checks. Nonempty, hidden-content, symlink, unreadable and missing mandatory-output cases remain rejection controls.",
        "evidence_ids": [
          "dependencies-repair",
          "empty-root-regression"
        ]
      },
      "lesson": {
        "basis": "INFERENCE",
        "text": "Target-code closure validation must remain strict about bytes while handling a proven byte-empty optional-root transition consistently. Reprepare or retry only under explicit current authority and a fresh process when code changed.",
        "evidence_ids": [
          "dependencies-repair",
          "empty-root-red",
          "empty-root-green"
        ]
      },
      "causal_chain": [
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "The recovered profile identified the optional resource root as incomplete because the empty inventory object was unavailable.",
          "evidence_ids": [
            "client-recovery-profile"
          ]
        },
        {
          "basis": "DIRECT_OBSERVATION",
          "text": "The focused regression first failed, then the repaired root-selection suite recorded 66 passing tests with 16 deselected.",
          "evidence_ids": [
            "empty-root-red",
            "empty-root-green"
          ]
        }
      ],
