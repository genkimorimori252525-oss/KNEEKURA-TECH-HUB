      "required_bounds": ["acquisition_range_or_query_bound", "member_limit_or_explicit_policy", "separation_policy"]
    },
    {
      "id": "BCT-X",
      "name": "Client FX Budget",
      "required_state": ["max_live", "lifetime", "eviction_policy", "distance_policy", "detail_policy", "disabled_policy"],
      "required_bounds": ["max_live", "lifetime", "creation_rate_or_aggregation"]
    },
    {
      "id": "BCT-P",
      "name": "Boss Presentation",
      "required_state": ["presentation_mode", "priority", "loop_sources", "cleanup_policy"],
      "required_bounds": ["screen_effect_cap", "loop_cleanup_bound"]
